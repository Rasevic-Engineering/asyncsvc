rules_version = '2';

// Firestore holds the admin Activity feed and Live data status. Browsers may read them
// when they're an admin; nobody may write from a browser (the worker writes
// with its service account, which bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true &&
         request.auth.token.email.lower() in __ADMIN_EMAILS__)
      );
    }

    match /activity/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Live data ingestion status (NHL games, soccer replays).
    match /ingest/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
